# Required — every route (including /health) rejects requests without a matching
# X-Internal-Api-Key header.
EXECUTION_SERVICE_API_KEY=dev-local-key

# Optional tuning (defaults shown)
# PORT=3000
# DEFAULT_TIMEOUT_MS=5000
# HARD_MAX_TIMEOUT_MS=15000
# COMPILE_TIMEOUT_MS=10000
# EXEC_MEMORY_LIMIT_KB=262144
# JAVA_MAX_HEAP_MB=256
# MAX_CONCURRENT_EXECUTIONS=2
# MAX_QUEUED_EXECUTIONS=10
# CACHE_TTL_MS=900000
# CACHE_MAX_ENTRIES=40
